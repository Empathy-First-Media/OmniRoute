#!/usr/bin/env sh
# .husky/pre-push — fast correctness net before anything leaves the machine.
# Heavy lanes (unit/vitest/e2e/coverage) stay in CI per the admission policy.
set -eu

if ! command -v npm >/dev/null 2>&1; then
  echo "⚠️  npm not found in PATH — skipping pre-push hooks"
  echo "   Run 'npm run typecheck:core && npm run check:asyncapi' manually before pushing."
  exit 0
fi

npm run typecheck:core
npm run check:asyncapi
